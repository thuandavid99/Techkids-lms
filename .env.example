# Sao chép file này thành .env.local rồi điền giá trị thật (xem README, bước 6).
# KHÔNG đẩy .env.local lên GitHub.

# Supabase → Project Settings → API (hoặc Data API) → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → khóa "anon" / "publishable" (công khai, được phép ở trình duyệt)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase → Project Settings → API Keys → khóa "service_role" / "secret" (BÍ MẬT — chỉ dùng ở server)
# KHÔNG đặt tiền tố NEXT_PUBLIC_ cho biến này.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Đuôi email ảo cho học sinh: ma_hs@<HS_EMAIL_DOMAIN>. Chọn MỘT LẦN, không đổi về sau.
# Không dùng đuôi .local. Hệ thống không gửi email nên tên miền này không cần có thật.
HS_EMAIL_DOMAIN=hs.techkids-lms.vn
